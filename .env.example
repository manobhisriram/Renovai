# =====================================================================================================
# RenovAI configuration.  Copy to `.env` and fill in.  NEVER commit `.env` (it is git-ignored).
# Variables marked REQUIRED must be set for the stated mode; everything else has a safe default.
# Docker Compose reads this file too (see docs/deployment.md).
# =====================================================================================================

# ---- Application ---------------------------------------------------------------------------------
APP_ENV=development                      # development | test | production
APP_NAME=RenovAI
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173       # comma-separated. Production: your real front-end origin(s); '*' is rejected.
SECRET_KEY=dev-insecure-secret-change-me-0000000000   # REQUIRED in production: `openssl rand -hex 32` (>= 32 chars)
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOW_SELF_REGISTRATION=false            # the very first account is always allowed and becomes admin
SEED_ADMIN_EMAIL=admin@renovai.local
SEED_ADMIN_PASSWORD=                     # set to create/seed the admin user (python -m scripts.seed). Choose a strong password.

# ---- Datastores ----------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./renovai.db      # REQUIRED in production: postgresql://user:pass@host:5432/renovai
REDIS_URL=                               # optional: shared rate limiting across replicas, e.g. redis://redis:6379/0
GRAPH_CHECKPOINT_BACKEND=auto            # auto | memory | sqlite | postgres  (auto: postgres if DATABASE_URL is postgres, else sqlite)
GRAPH_CHECKPOINT_SQLITE_PATH=./renovai_checkpoints.db

# ---- LLM (choose a provider) ----------------------------------------------------------------------
LLM_PROVIDER=anthropic                   # anthropic | openai (OpenAI-compatible: OpenAI, vLLM, Ollama...) | mock (tests/offline demo only)
# Model ids per tier. VERIFY against https://platform.claude.com/docs/en/about-claude/models/overview before deploying.
LLM_MODEL_SIMPLE=claude-haiku-4-5-20251001
LLM_MODEL_MEDIUM=claude-sonnet-5-5
LLM_MODEL_COMPLEX=claude-opus-5-5
LLM_FALLBACK_ENABLED=true                # fall back to a cheaper tier if the chosen model is unavailable
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TASK_TIER_OVERRIDES=                 # JSON, e.g. {"vision_analysis": "complex"}
LLM_PRICING_JSON=                        # JSON of USD per 1M tokens to enable cost estimates, e.g. {"claude-haiku": {"input": 1.0, "output": 5.0}}
ANTHROPIC_API_KEY=                       # REQUIRED when LLM_PROVIDER=anthropic. Create at https://platform.claude.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
OPENAI_API_KEY=                          # REQUIRED when LLM_PROVIDER=openai or VIZ_PROVIDER=openai_images
OPENAI_BASE_URL=https://api.openai.com/v1   # point at a local server (e.g. http://ollama:11434/v1) for open-source models

# ---- RAG / vector database -----------------------------------------------------------------------
QDRANT_URL=                              # REQUIRED in production. Qdrant Cloud URL or http://qdrant:6333. Empty = embedded local mode (dev only)
QDRANT_API_KEY=                          # Qdrant Cloud API key (leave empty for a private, un-authenticated Qdrant)
QDRANT_LOCAL_PATH=./qdrant_data
QDRANT_COLLECTION=renovai_knowledge
EMBEDDING_PROVIDER=hash                  # hash (dev/CI, lexical) | sentence_transformers (production, needs requirements-ml.txt)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384                        # must match the model; changing it requires a new QDRANT_COLLECTION
RAG_TOP_K=6
RAG_CANDIDATE_K=18
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=120
RAG_CONTEXT_MAX_CHARS=7000

# ---- Computer vision (optional) ------------------------------------------------------------------
CV_DETECTOR_MODEL=                       # path/name of YOLO weights (requires requirements-ml.txt). Empty = no object detector

# ---- File storage --------------------------------------------------------------------------------
STORAGE_BACKEND=local                    # local | s3
UPLOAD_DIR=./uploads
S3_BUCKET=                               # REQUIRED when STORAGE_BACKEND=s3
S3_REGION=                               # REQUIRED when STORAGE_BACKEND=s3
S3_ENDPOINT_URL=                         # optional: MinIO / S3-compatible endpoint
# AWS credentials come from the standard AWS chain (IAM role on ECS/EC2, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars).
MAX_UPLOAD_MB=8
MAX_IMAGES_PER_PROJECT=12
MAX_IMAGE_PIXELS=40000000

# ---- CRM -----------------------------------------------------------------------------------------
CRM_PROVIDER=internal                    # internal (built-in, free) | hubspot | google_sheets
HUBSPOT_ACCESS_TOKEN=                    # REQUIRED for hubspot: private-app token (scopes: crm.objects.contacts.read/write, crm.objects.notes.write)
HUBSPOT_BASE_URL=https://api.hubapi.com
GOOGLE_SHEETS_SPREADSHEET_ID=            # REQUIRED for google_sheets; share the sheet with the service-account email (Editor)
GOOGLE_SHEETS_RANGE=Leads!A:L
GOOGLE_SERVICE_ACCOUNT_JSON=             # REQUIRED for google_sheets: the whole service-account key JSON on one line (use a secrets manager)

# ---- AI visualisation (optional) -----------------------------------------------------------------
VIZ_PROVIDER=none                        # none | openai_images
VIZ_OPENAI_MODEL=gpt-image-1

# ---- Notifications (optional) --------------------------------------------------------------------
SMTP_HOST=                               # empty = notifications are logged, not e-mailed
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=renovai@localhost
NOTIFY_REVIEWER_EMAIL=                   # who is e-mailed when a quote needs approval

# ---- Business rules ------------------------------------------------------------------------------
DEFAULT_CURRENCY=INR
DEFAULT_TAX_PCT=18
DEFAULT_CONTINGENCY_PCT=8
DEFAULT_LOGISTICS_PCT=3
APPROVAL_REQUIRE_ALWAYS=true             # true: a person approves every quote. false: only when a threshold below trips
APPROVAL_TOTAL_THRESHOLD=2500000
APPROVAL_MIN_CONFIDENCE=0.6
MAX_CLARIFICATION_ROUNDS=2

# ---- Limits --------------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
TOOL_TIMEOUT_SECONDS=15

# ---- Observability -------------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_TOKEN=                           # if set, /metrics requires header X-Metrics-Token. Set it in production, or block /metrics at the proxy.
OTEL_EXPORTER_OTLP_ENDPOINT=             # e.g. http://otel-collector:4318 (needs requirements-otel.txt)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Docker Compose only (not read by the app) ---------------------------------------------------
POSTGRES_USER=renovai
POSTGRES_PASSWORD=change-me-in-.env      # REQUIRED for docker compose; use a long random value
POSTGRES_DB=renovai
QDRANT_IMAGE_TAG=v1.12.4                 # self-hosted Qdrant image tag; bump after checking https://hub.docker.com/r/qdrant/qdrant/tags
INSTALL_ML=false                         # true: build the backend image with sentence-transformers/ultralytics (large image)
RUN_MIGRATIONS=true                      # backend container runs `alembic upgrade head` on start. Set false for multi-replica deploys
FORWARDED_ALLOW_IPS=*                    # uvicorn trusts X-Forwarded-For only from these IPs. '*' is safe ONLY because the backend is not published
